{
  "manifest_version": 3,
  "name": "Finessers — Browser Operator",
  "version": "0.2.0",
  "description": "User-approved active-tab navigation and page controls.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "action": {
    "default_title": "FINESSERS. Connect tab",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "popup.html?panel=1"
  }
}
